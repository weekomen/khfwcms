[Unit]
Description=Kehoubang website and CMS
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=khfwcms
Group=khfwcms
WorkingDirectory=/opt/khfwcms/current
EnvironmentFile=/etc/khfwcms/khfwcms.env
# Verify this absolute path on the target server; do not depend on nvm or shell profiles.
ExecStart=/usr/local/bin/node /opt/khfwcms/current/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
StateDirectory=khfwcms
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/khfwcms
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=khfwcms

[Install]
WantedBy=multi-user.target
