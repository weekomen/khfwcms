# Loaded by systemd EnvironmentFile, not automatically by Node.js.
# Canonical website origin. www redirects here; khb is a separate application.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/khfwcms
PUBLIC_ORIGIN=https://kehoubang.cn
TRUST_PROXY=loopback
# Do not set ADMIN_TOKEN for a new production deployment.
# A random initial password is generated in DATA_DIR/admin-token.
